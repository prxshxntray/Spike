    {
      "id": "l22",
      "number": 22,
      "title": "A drain with its own memory",
      "type": "lesson",
      "concepts": [
        "izh"
      ],
      "cards": [
        {
          "kind": "analogy",
          "title": "A drain with its own memory",
          "body": "The beaker has fast water level v and a slower recovery state u, like a drain that widens after a tip. This is an analogy: u is a signed recovery current, not literally a hole.",
          "diagram": {
            "kind": "flow",
            "title": "Two states change at a spike",
            "caption": "Voltage and recovery follow different update rules.",
            "items": [
              {
                "label": "Voltage v",
                "value": 0,
                "note": "Reset to c."
              },
              {
                "label": "Recovery u",
                "value": 0,
                "note": "Add d to the existing value."
              },
              {
                "label": "Between spikes",
                "value": 0,
                "note": "Both states continue evolving."
              }
            ]
          }
        },
        {
          "kind": "numbers",
          "title": "Reset voltage, then increase recovery",
          "body": "At a spike, reset v to c and add d to u. Regular spiking uses a = 0.02, b = 0.2, c = −65, d = 8. Chattering uses the same a,b with c = −50, d = 2."
        },
        {
          "kind": "sim",
          "title": "Try it yourself",
          "simId": "izhikevich",
          "body": "Change one thing. Predict what will happen, then test it."
        },
        {
          "kind": "equation",
          "title": "Write the rule",
          "body": "The symbols describe the example you just saw.",
          "steps": [
            "\\dot v=0.04v^2+5v+140-u+I",
            "\\dot u=a(bv-u)",
            "v\\ge30:\\quad v\\leftarrow c,\\;u\\leftarrow u+d"
          ]
        }
      ],
      "quiz": [
