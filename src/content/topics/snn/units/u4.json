            }
          ],
          "concept": "memory",
          "requires": [],
          "misconceptions": {
            "0": "Start with 1: multiply by 0.9 to get 0.9, so only 0.1 was lost."
          }
        },
        {
          "id": "l21-q2",
          "kind": "single",
          "prompt": "Which remembers longer?",
          "answer": "1",
          "why": "0.98 loses just 2% per step, so decay is slower.",
          "options": [
            {
              "id": "0",
              "text": "ρ = 0.8"
            },
            {
              "id": "1",
              "text": "ρ = 0.98"
            }
