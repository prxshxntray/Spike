{
  "id": "u4",
  "title": "Richer neurons",
  "levels": [
    {
      "id": "l20",
      "number": 20,
      "title": "A tipping line that remembers",
      "type": "lesson",
      "concepts": [
        "alif"
      ],
      "cards": [
        {
          "kind": "analogy",
          "title": "A tipping line that remembers",
          "body": "Give the tipping line a temporary extra height a. Each spike adds a jump; between spikes that extra keeps a fraction ρ. The baseline line stays fixed.",
          "diagram": {
            "kind": "bars",
            "title": "The baseline stays. The extra fades.",
            "caption": "Baseline threshold = 1. Bars show only the extra a, keeping 80% per silent step.",
            "items": [
              {
                "label": "After spike",
                "value": 0.5,
                "note": "+0.5"
              },
              {
                "label": "1 step",
                "value": 0.4,
                "note": "+0.4"
              },
              {
                "label": "2 steps",
                "value": 0.32,
                "note": "+0.32"
              }
            ]
          }
        },
        {
          "kind": "numbers",
          "title": "The extra threshold fades",
          "body": "θ₀ = 1, jump = 0.5, ρ = 0.8. Immediately after a spike θ = 1.5. Silent steps give 1.4, 1.32, 1.256."
        },
        {
          "kind": "tracker",
          "title": "Follow the changes",
          "columns": [
            "Silent steps",
            "Extra a",
            "Threshold",
            "Spike?",
            "Note"
          ],
          "rows": [
            [
              "0",
              "0.5",
              "1.5",
              "Just fired",
              "Jump added"
            ],
            [
              "1",
              "0.4",
              "1.4",
              "No",
              "Keep 80% of extra"
            ],
            [
              "2",
              "0.32",
              "1.32",
              "No",
              "Baseline is unchanged"
            ],
            [
              "3",
              "0.256",
              "1.256",
              "No",
              "Extra keeps fading"
            ]
          ]
        },
        {
          "kind": "equation",
          "title": "Write the rule",
          "body": "The symbols describe the example you just saw.",
          "steps": [
            "\\theta_t=\\theta_0+a_t",
            "a_{t+1}=\\rho a_t+J s_t"
          ]
        }
      ],
      "quiz": [
        {
          "id": "l20-q0",
          "kind": "number",
          "prompt": "θ₀ = 1, a = 0.5, ρ = 0.8. After TWO silent decays, what is θ?",
          "answer": 1.32,
          "why": "Extra: 0.5 → 0.4 → 0.32. Add baseline 1.",
          "concept": "alif",
          "requires": [
            "leak"
          ],
          "misconceptions": {},
          "tolerance": 0.01
        },
        {
          "id": "l20-q1",
          "kind": "single",
          "prompt": "Under steady strong drive, adaptation often makes firing…",
          "answer": "0",
          "why": "Past spikes raise the threshold and reduce excitability.",
          "options": [
            {
              "id": "0",
              "text": "Slow after an initial fast response"
            },
            {
              "id": "1",
              "text": "Speed up forever"
            }
          ],
          "concept": "alif",
          "requires": [],
          "misconceptions": {}
        }
      ],
      "retries": [
        {
          "id": "l20-r0",
          "kind": "number",
          "prompt": "θ₀ = 1, a = 0.6, ρ = 0.5. After one silent decay, what is θ?",
          "answer": 1.3,
          "why": "a becomes 0.3; baseline plus extra is 1.3.",
          "concept": "alif",
          "requires": [],
