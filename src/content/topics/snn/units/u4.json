      "newTerms": [
        {
          "term": "Memory timescale",
          "meaning": "How long a state continues to influence future dynamics."
        },
        {
          "term": "Fast vs slow variable",
          "meaning": "States that relax on different timescales."
        },
        {
          "term": "Multiple timescales",
          "meaning": "Several coexisting rates of state evolution."
        },
        {
          "term": "LSNN",
          "meaning": "Long short-term memory spiking neural network using adaptive neurons."
        }
