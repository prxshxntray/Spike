    {
      "id": "l21",
      "number": 21,
      "title": "Kept is not lost",
      "type": "lesson",
      "concepts": [
        "memory"
      ],
      "cards": [
        {
          "kind": "analogy",
          "title": "Kept is not lost",
          "body": "The extra threshold is a slow memory of previous tips. When ρ is near 1, very little disappears each step. That tiny lost fraction sets a long timescale.",
          "diagram": {
            "kind": "bars",
            "title": "A small loss means a longer memory",
            "caption": "Approximate memory, in steps: 1/(1−ρ). This approximation works best near ρ = 1.",
            "items": [
              {
                "label": "ρ = 0.9",
                "value": 10,
                "note": "10 steps"
              },
              {
                "label": "ρ = 0.95",
                "value": 20,
                "note": "20 steps"
              },
              {
                "label": "ρ = 0.98",
                "value": 50,
                "note": "50 steps"
              }
            ]
          }
        },
        {
          "kind": "numbers",
          "title": "Keep 95%, lose 5%",
          "body": "ρ = 0.9 keeps 90%, loses 10%. The near-one approximation gives 1 / 0.1 = 10 steps. For ρ = 0.95 it gives 20. At ρ = 0.5 it gives 2, but the exact e-fold time is about 1.44 steps."
        },
        {
          "kind": "tracker",
          "title": "Follow the changes",
          "columns": [
            "ρ",
            "Kept",
            "Lost",
            "Approx. steps",
            "Exact e-fold steps"
          ],
          "rows": [
            [
              "0.5",
              "50%",
              "50%",
              "2",
              "1.443"
            ],
            [
              "0.9",
              "90%",
              "10%",
              "10",
              "9.491"
            ],
            [
              "0.95",
              "95%",
              "5%",
              "20",
              "19.496"
            ]
          ]
        },
        {
          "kind": "equation",
          "title": "Write the rule",
          "body": "The symbols describe the example you just saw.",
          "steps": [
            "\\tau_{\\mathrm{steps}}=-\\frac{1}{\\ln\\rho}",
            "\\tau_{\\mathrm{steps}}\\approx\\frac{1}{1-\\rho}\\quad(\\rho\\approx1)"
          ]
        }
      ],
      "quiz": [
        {
          "id": "l21-q0",
          "kind": "number",
          "prompt": "ρ = 0.95. Using 1/(1−ρ), what is the approximate memory in steps?",
          "answer": 20,
