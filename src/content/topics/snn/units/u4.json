      ],
      "newTerms": [
        {
          "term": "ALIF",
          "meaning": "Adaptive leaky integrate-and-fire neuron."
        },
        {
          "term": "Adaptation variable a",
          "meaning": "A state recording the recent history of activity."
        },
        {
          "term": "Adaptation strength",
          "meaning": "The size of an adaptation increment per spike."
        },
        {
          "term": "Adaptation decay ρ",
          "meaning": "The retained fraction of adaptation per step."
        },
        {
          "term": "Adaptation time constant τₐ",
          "meaning": "The physical decay timescale associated with ρ."
        },
        {
          "term": "Spike-frequency adaptation",
          "meaning": "A reduced firing rate after sustained stimulation."
        }
      ],
      "goDeeper": []
