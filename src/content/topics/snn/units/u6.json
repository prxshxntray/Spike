    {
      "id": "l27",
      "number": 27,
      "title": "A synapse has a shape in time",
      "type": "lesson",
      "concepts": [
        "synapse"
      ],
      "cards": [
        {
          "kind": "analogy",
          "title": "A synapse has a shape in time",
          "body": "A synaptic event can open a tap whose flow fades. In a current-based model the injected current is specified directly. In a conductance-based model, flow also depends on the beaker’s present level relative to a reversal level.",
          "diagram": {
            "kind": "bars",
            "title": "Same channel, smaller driving force",
            "caption": "With g = 0.5, inward-positive current follows E−V.",
            "items": [
              {
                "label": "E−V = 4",
                "value": 2,
                "note": "Current 2"
              },
              {
                "label": "E−V = 1",
                "value": 0.5,
                "note": "Current 0.5"
              }
            ]
          }
        },
        {
          "kind": "numbers",
          "title": "Same conductance, different current",
          "body": "If g = 0.5 and E − V = 4, inward-positive synaptic current is 2. If the voltage difference shrinks to 1, the same conductance produces 0.5."
        },
        {
          "kind": "equation",
          "title": "Write the rule",
          "body": "The symbols describe the example you just saw.",
          "steps": [
            "I_{\\mathrm{syn}}=g_{\\mathrm{syn}}(E_{\\mathrm{syn}}-V)",
            "\\alpha(t)=\\frac{t}{\\tau}e^{1-t/\\tau}\\quad(t\\ge0)"
          ]
        }
      ],
