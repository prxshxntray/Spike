      "title": "Channels are changing gates",
      "type": "lesson",
      "concepts": [
        "hh"
      ],
      "cards": [
        {
          "kind": "analogy",
          "title": "Channels are changing gates",
          "body": "The beaker now has several gated pipes. Each pipe’s flow depends on its opening and on the difference between water level and that pipe’s preferred level. This is a conceptual analogy for conductances and reversal potentials.",
          "diagram": {
            "kind": "flow",
            "title": "An open channel still needs a driving force",
            "caption": "Outward-positive current: I = g(V−E).",
            "items": [
              {
                "label": "Conductance g",
                "value": 0,
                "note": "How open the pathway is."
              },
              {
                "label": "Driving force V−E",
                "value": 0,
                "note": "How far voltage is from reversal."
              },
              {
                "label": "At V = E",
                "value": 0,
                "note": "No net current through that channel."
              }
            ]
          }
        },
        {
          "kind": "numbers",
          "title": "Current depends on the driving force",
          "body": "With conductance g = 2 and voltage difference V − E = 3, outward current is 6 in consistent units. At V = E, net current through that channel is zero even if the channel is open."
        },
        {
          "kind": "equation",
          "title": "Write the rule",
          "body": "The symbols describe the example you just saw.",
          "steps": [
            "I_{\\mathrm{ion}}=g(V-E)",
            "C_m\\dot V=I_{\\mathrm{ext}}-\\sum I_{\\mathrm{ion}}"
          ]
        }
      ],
      "quiz": [
