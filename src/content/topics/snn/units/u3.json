          "why": "0.7 − 0.2 = 0.5.",
          "concept": "wta",
          "requires": [],
          "misconceptions": {},
          "tolerance": 0.01
        },
        {
          "id": "l17-r1",
          "kind": "single",
          "prompt": "What makes a connection inhibitory here?",
          "answer": "0",
          "why": "A negative contribution suppresses threshold crossing.",
          "options": [
            {
              "id": "0",
              "text": "It pushes the neighbor’s state down"
            },
            {
              "id": "1",
              "text": "It always increases its rate"
            }
          ],
          "concept": "wta",
          "requires": [],
          "misconceptions": {}
        }
      ],
      "newTerms": [
        {
          "term": "Lateral inhibition",
          "meaning": "Neurons suppressing other neurons in a population."
        },
        {
          "term": "Winner-take-all",
          "meaning": "Competition that selects one or a small set of active winners."
        },
        {
          "term": "Inhibitory synapse",
          "meaning": "A connection tending to suppress postsynaptic spiking."
        },
        {
          "term": "Competitive learning",
          "meaning": "Learning shaped by competition among units."
        },
        {
          "term": "Unsupervised learning",
          "meaning": "Learning structure without target labels guiding the update."
        }
      ],
      "goDeeper": []
    },
    {
      "id": "l18",
      "number": 18,
      "title": "Give the quiet ones a chance",
      "type": "lesson",
      "concepts": [
        "homeostasis"
      ],
      "cards": [
        {
          "kind": "analogy",
          "title": "Start with the beaker",
          "body": "A frequent winner gets a higher tipping line. A quiet neuron’s extra threshold can relax downward. This helps distribute activity."
        },
        {
          "kind": "numbers",
          "title": "Make it concrete",
          "body": "A winner at θ = 1 gains 0.2: θ becomes 1.2. Under the same input, it is now harder to win the next competition."
        },
        {
          "kind": "equation",
          "title": "Now give it symbols",
          "body": "The symbols describe the example you just saw.",
          "steps": [
            "\\theta\\leftarrow\\theta+\\delta\\quad\\text{after a spike}"
          ]
        }
      ],
      "quiz": [
        {
          "id": "l18-q0",
          "kind": "single",
          "prompt": "Disable homeostasis in a competitive network. What can happen?",
          "answer": "0",
          "why": "Competition alone does not enforce balanced use.",
          "options": [
            {
              "id": "0",
              "text": "A few neurons dominate"
            },
            {
              "id": "1",
              "text": "All neurons must win equally"
