          "prompt": "A quiet neuron’s adaptive threshold relaxes. It becomes…",
          "answer": "0",
          "why": "Lowering the line increases excitability.",
          "options": [
            {
              "id": "0",
              "text": "Easier to recruit"
            },
            {
              "id": "1",
              "text": "Harder to recruit"
            }
          ],
          "concept": "homeostasis",
          "requires": [],
          "misconceptions": {}
        },
        {
          "id": "l18-r1",
          "kind": "number",
          "prompt": "Threshold 1.1 receives a 0.3 increment. New threshold?",
          "answer": 1.4,
          "why": "1.1 + 0.3 = 1.4.",
          "concept": "homeostasis",
          "requires": [],
          "misconceptions": {},
          "tolerance": 0.01
        }
      ],
      "newTerms": [
        {
          "term": "Homeostasis",
          "meaning": "Feedback that keeps activity within a useful range."
        },
        {
          "term": "Homeostatic plasticity",
          "meaning": "Slow adjustments that stabilize activity."
        },
        {
          "term": "Intrinsic plasticity",
          "meaning": "Changes in a neuron’s own excitability."
        },
        {
          "term": "Adaptive threshold",
          "meaning": "A threshold that changes with state or activity."
        },
        {
          "term": "Dead-neuron problem",
          "meaning": "Units receiving little or no activity or useful learning."
        }
      ],
      "goDeeper": []
    },
    {
