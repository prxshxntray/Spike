{
  "id": "u3",
  "title": "Learning with spikes",
  "levels": [
    {
      "id": "l14",
      "number": 14,
      "title": "Timing changes the connection",
      "type": "lesson",
      "concepts": [
        "stdp"
      ],
      "cards": [
        {
          "kind": "analogy",
          "title": "Start with the beaker",
          "body": "If one beaker’s event helps another tip soon after, strengthen their connection in a conventional pair-based STDP rule. Reverse their order and weaken it."
        },
        {
          "kind": "numbers",
          "title": "Make it concrete",
          "body": "Pre at 10 ms, post at 15 ms gives Δt = +5 ms: potentiation. Post at 10 ms, pre at 15 ms gives Δt = −5 ms: depression."
        },
        {
          "kind": "equation",
          "title": "Now give it symbols",
          "body": "The symbols describe the example you just saw.",
          "steps": [
            "\\Delta t=t_{\\mathrm{post}}-t_{\\mathrm{pre}}",
            "\\Delta t>0\\Rightarrow\\mathrm{LTP}\\quad\\Delta t<0\\Rightarrow\\mathrm{LTD}"
          ]
        },
        {
          "kind": "text",
          "title": "Keep this distinction",
          "body": "This is the conventional pair-based timing rule. Biological and model-specific STDP rules can have different windows and dependencies."
        }
      ],
      "quiz": [
        {
          "id": "l14-q0",
          "kind": "single",
          "prompt": "Pre fires at 12 ms; post at 17 ms. Conventional pair STDP predicts…",
          "answer": "0",
          "why": "Pre precedes post by 5 ms.",
          "options": [
            {
              "id": "0",
              "text": "Strengthening"
            },
            {
              "id": "1",
              "text": "Weakening"
            }
          ],
          "concept": "stdp",
          "requires": [],
          "misconceptions": {}
        },
        {
          "id": "l14-q1",
          "kind": "single",
          "prompt": "Post at 8 ms; pre at 11 ms predicts…",
          "answer": "1",
          "why": "Post precedes pre: Δt is negative.",
          "options": [
            {
              "id": "0",
              "text": "Strengthening"
            },
            {
              "id": "1",
              "text": "Weakening"
            }
          ],
          "concept": "stdp",
          "requires": [],
          "misconceptions": {}
        }
      ],
      "retries": [
        {
          "id": "l14-r0",
          "kind": "single",
          "prompt": "Pre at 20 ms; post at 22 ms predicts…",
          "answer": "0",
          "why": "Positive post-minus-pre timing gives potentiation.",
          "options": [
            {
              "id": "0",
              "text": "LTP"
            },
            {
              "id": "1",
              "text": "LTD"
            }
          ],
          "concept": "stdp",
          "requires": [],
          "misconceptions": {}
        },
        {
          "id": "l14-r1",
          "kind": "number",
          "prompt": "Pre = 14 ms, post = 9 ms. What is Δt in ms?",
          "answer": -5,
          "why": "9 − 14 = −5.",
          "concept": "stdp",
          "requires": [],
          "misconceptions": {},
          "tolerance": 0.01
        }
      ],
      "newTerms": [
        {
          "term": "STDP",
          "meaning": "Spike-timing-dependent plasticity."
        },
        {
          "term": "LTP",
          "meaning": "Long-term potentiation: a lasting increase in synaptic strength."
        },
        {
          "term": "LTD",
          "meaning": "Long-term depression: a lasting decrease in synaptic strength."
        },
        {
          "term": "Local learning rule",
          "meaning": "An update using information available near the synapse."
        }
      ],
      "goDeeper": []
    },
    {
      "id": "l15",
      "number": 15,
      "title": "A fading timing trace",
      "type": "lesson",
      "concepts": [
        "trace"
      ],
      "cards": [
        {
          "kind": "analogy",
          "title": "Start with the beaker",
          "body": "A recent tip leaves a fading mark. When the other neuron fires, the mark’s remaining strength says how recent the first event was."
        },
        {
          "kind": "numbers",
          "title": "Make it concrete",
          "body": "For τ = 10 ms, a gap of 10 ms leaves e⁻¹ ≈ 0.368 of the peak effect; 20 ms leaves about 0.135."
        },
        {
          "kind": "equation",
          "title": "Now give it symbols",
          "body": "The symbols describe the example you just saw.",
          "steps": [
            "x(t)=e^{-t/\\tau}",
            "|\\Delta w|=A e^{-|\\Delta t|/\\tau}"
          ]
        }
      ],
      "quiz": [
        {
          "id": "l15-q0",
          "kind": "number",
          "prompt": "A trace is 1 and retains 0.5 per step. After two silent steps, what remains?",
          "answer": 0.25,
          "why": "1 → 0.5 → 0.25.",
          "concept": "trace",
          "requires": [
            "leak"
          ],
          "misconceptions": {},
          "tolerance": 0.01
        },
        {
          "id": "l15-q1",
          "kind": "single",
          "prompt": "Same STDP branch and amplitude: which gap has a larger update?",
          "answer": "0",
          "why": "Exponential traces are stronger at shorter gaps.",
          "options": [
            {
              "id": "0",
              "text": "5 ms"
            },
            {
              "id": "1",
              "text": "25 ms"
            }
          ],
          "concept": "trace",
          "requires": [
            "stdp"
          ],
          "misconceptions": {}
        }
      ],
      "retries": [
        {
          "id": "l15-r0",
          "kind": "number",
          "prompt": "A trace of 0.8 keeps 0.5 for one step. What remains?",
          "answer": 0.4,
          "why": "0.8 × 0.5 = 0.4.",
          "concept": "trace",
          "requires": [],
          "misconceptions": {},
          "tolerance": 0.01
        },
        {
          "id": "l15-r1",
          "kind": "single",
          "prompt": "Increasing τ makes a continuous exponential trace decay…",
          "answer": "0",
          "why": "A larger time constant spreads memory over a longer interval.",
          "options": [
            {
              "id": "0",
              "text": "Slower"
            },
            {
              "id": "1",
              "text": "Faster"
            }
          ],
          "concept": "trace",
          "requires": [],
          "misconceptions": {}
        }
      ],
      "newTerms": [
        {
          "term": "STDP window",
          "meaning": "How a timing gap maps to a synaptic update."
        },
        {
          "term": "Time constant τ",
          "meaning": "The time for exponential decay to reach 1/e of its initial value."
        },
        {
          "term": "Spike trace",
          "meaning": "A decaying record of recent spike activity."
        },
        {
          "term": "Eligibility trace",
          "meaning": "A fading record that can make a synapse eligible for a later update."
        }
      ],
      "goDeeper": []
    },
    {
      "id": "l16",
      "number": 16,
      "title": "A tag waits for a third signal",
      "type": "lesson",
      "concepts": [
        "rstdp"
      ],
      "cards": [
        {
          "kind": "analogy",
          "title": "Start with the beaker",
          "body": "Timing leaves an eligibility tag on the connection. A later modulatory signal can turn that tag into a weight change before it fades."
        },
        {
          "kind": "numbers",
          "title": "Make it concrete",
          "body": "Eligibility e = 0.4, reward signal R = 0.5, learning rate η = 0.1: Δw = 0.02. With R = 0, the pure three-factor update is zero."
        },
        {
          "kind": "equation",
          "title": "Now give it symbols",
          "body": "The symbols describe the example you just saw.",
          "steps": [
            "\\Delta w=\\eta R e"
          ]
        }
      ],
      "quiz": [
        {
          "id": "l16-q0",
          "kind": "number",
          "prompt": "η = 0.2, R = 0.5, e = 0.3. What is Δw?",
          "answer": 0.03,
          "why": "0.2 × 0.5 × 0.3 = 0.03.",
          "concept": "rstdp",
          "requires": [],
          "misconceptions": {},
          "tolerance": 0.01
        },
        {
          "id": "l16-q1",
          "kind": "single",
          "prompt": "Why can a delayed reward still affect a connection?",
          "answer": "0",
          "why": "The fading tag bridges the delay.",
          "options": [
            {
              "id": "0",
              "text": "An eligibility trace remains"
            },
            {
              "id": "1",
              "text": "The reward changes the original spike time"
            }
          ],
          "concept": "rstdp",
          "requires": [
            "trace"
          ],
          "misconceptions": {}
        }
      ],
      "retries": [
        {
          "id": "l16-r0",
          "kind": "number",
          "prompt": "η = 0.1, e = 0.6, R = 0. What is Δw?",
          "answer": 0,
          "why": "No modulatory signal means no update in this pure rule.",
          "concept": "rstdp",
          "requires": [],
          "misconceptions": {},
          "tolerance": 0.01
        },
        {
          "id": "l16-r1",
          "kind": "single",
          "prompt": "A tag that faded almost to zero gives a later reward…",
          "answer": "0",
          "why": "The update is proportional to remaining eligibility.",
          "options": [
            {
              "id": "0",
              "text": "Little effect through that tag"
            },
            {
              "id": "1",
              "text": "The original full effect"
            }
          ],
          "concept": "rstdp",
          "requires": [],
          "misconceptions": {}
        }
      ],
      "newTerms": [
        {
          "term": "Three-factor rule",
          "meaning": "An update combining pre/post activity with a modulatory signal."
        },
        {
          "term": "Neuromodulator",
          "meaning": "A signal that changes how neurons or synapses respond."
        },
        {
          "term": "Dopamine",
          "meaning": "A biological neuromodulator often modeled as a learning signal."
        },
        {
          "term": "Credit assignment",
          "meaning": "Determining which past activity should receive an update."
        }
      ],
      "goDeeper": []
    },
    {
      "id": "l17",
      "number": 17,
      "title": "Let one beaker win",
      "type": "lesson",
      "concepts": [
        "wta"
      ],
      "cards": [
        {
          "kind": "analogy",
          "title": "Start with the beaker",
          "body": "The first beaker to tip pushes its neighbors’ water down. Competition reduces simultaneous winners, allowing different neurons to specialize."
        },
        {
          "kind": "numbers",
          "title": "Make it concrete",
          "body": "A and B are approaching threshold. A spikes first and sends −0.4 to B. If B was at 0.9, its state falls to 0.5."
        },
        {
          "kind": "equation",
          "title": "Now give it symbols",
          "body": "The symbols describe the example you just saw.",
          "steps": [
            "v_B\\leftarrow v_B-w_{\\mathrm{inh}}"
          ]
        }
      ],
      "quiz": [
        {
          "id": "l17-q0",
          "kind": "number",
          "prompt": "B is at 0.85 and receives inhibition of magnitude 0.3. New state?",
          "answer": 0.55,
          "why": "0.85 − 0.3 = 0.55.",
          "concept": "wta",
          "requires": [],
          "misconceptions": {},
          "tolerance": 0.01
        },
        {
          "id": "l17-q1",
          "kind": "single",
          "prompt": "WTA competition alone guarantees every neuron wins equally often?",
          "answer": "1",
