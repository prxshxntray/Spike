      "newTerms": [
        {
          "term": "Temporal coding",
          "meaning": "Representing information in event timing."
        },
        {
          "term": "Time-to-first-spike",
          "meaning": "A code using the latency of the first event."
        },
        {
          "term": "Latency coding",
          "meaning": "A code based on delay relative to a reference time."
        },
        {
          "term": "Jitter",
