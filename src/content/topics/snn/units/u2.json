{
  "id": "u2",
  "title": "Coding & timing",
  "levels": [
    {
      "id": "l10",
      "number": 10,
      "title": "A pause after the spike",
      "type": "lesson",
      "concepts": [
        "refractory"
      ],
      "cards": [
        {
          "kind": "analogy",
          "title": "Start with the beaker",
          "body": "After tipping, imagine the beaker’s inlet temporarily closed. During an absolute refractory interval it cannot fire again. Relative refractoriness instead makes firing harder."
        },
        {
          "kind": "numbers",
          "title": "Make it concrete",
          "body": "Under a convention where successive spikes must be at least 4 ms apart, the ceiling is 1 / 0.004 = 250 spikes/s. Additional charging time can lower the actual rate."
        },
        {
          "kind": "equation",
          "title": "Now give it symbols",
          "body": "The symbols describe the example you just saw.",
          "steps": [
            "f_{\\max}\\leq\\frac{1}{t_{\\mathrm{ref}}}"
          ]
        }
      ],
      "quiz": [
        {
          "id": "l10-q0",
          "kind": "number",
          "prompt": "Minimum spike separation is 5 ms. What is the rate ceiling in spikes/s?",
          "answer": 200,
          "why": "1 / 0.005 = 200.",
          "concept": "refractory",
          "requires": [
            "time"
          ],
          "misconceptions": {},
          "tolerance": 0.01
        },
        {
          "id": "l10-q1",
          "kind": "single",
          "prompt": "During an absolute refractory interval, extra input…",
          "answer": "1",
          "why": "Absolute means firing is disallowed for that interval.",
          "options": [
            {
              "id": "0",
              "text": "Always forces a spike"
            },
            {
              "id": "1",
              "text": "Cannot cause another spike"
            }
          ],
          "concept": "refractory",
          "requires": [],
          "misconceptions": {}
        }
      ],
      "retries": [
        {
          "id": "l10-r0",
          "kind": "number",
          "prompt": "Minimum separation 10 ms gives what ceiling in spikes/s?",
          "answer": 100,
          "why": "1 / 0.01 = 100.",
          "concept": "refractory",
          "requires": [],
          "misconceptions": {},
          "tolerance": 0.01
        },
        {
          "id": "l10-r1",
          "kind": "single",
          "prompt": "Relative refractoriness means…",
          "answer": "0",
          "why": "The neuron is less excitable, not necessarily silent.",
          "options": [
            {
              "id": "0",
              "text": "Firing is harder"
            },
            {
              "id": "1",
              "text": "Firing is absolutely impossible"
            }
          ],
          "concept": "refractory",
          "requires": [],
          "misconceptions": {}
        }
      ],
      "newTerms": [
        {
          "term": "Absolute refractory period",
          "meaning": "An interval when another spike is disallowed."
        },
        {
          "term": "Relative refractory period",
          "meaning": "An interval of reduced excitability."
        },
        {
          "term": "Maximum firing rate",
          "meaning": "The largest rate allowed by the model and timing."
        },
        {
          "term": "Saturation",
          "meaning": "A limit beyond which more input no longer increases output."
        }
      ],
      "goDeeper": []
