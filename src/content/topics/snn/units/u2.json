    {
      "id": "l11",
      "number": 11,
      "title": "Count the tips",
      "type": "lesson",
      "concepts": [
        "rate"
      ],
      "cards": [
        {
          "kind": "analogy",
          "title": "Start with the beaker",
          "body": "Rate coding reads how many times the beaker tips in a window. It discards exact spike timing when only the count is decoded."
        },
        {
          "kind": "numbers",
          "title": "Make it concrete",
          "body": "Spikes at steps 2, 5, 9 and at 1, 6, 10 both encode count 3 in a 10-step window."
        },
        {
          "kind": "equation",
          "title": "Now give it symbols",
          "body": "The symbols describe the example you just saw.",
          "steps": [
            "r=\\frac{N}{T\\Delta t}"
          ]
        }
      ],
      "quiz": [
        {
          "id": "l11-q0",
          "kind": "single",
          "prompt": "Two trains each have 5 spikes in the same window but different timing. A count-only decoder reads them as…",
          "answer": "0",
          "why": "Equal count and duration mean equal rate.",
          "options": [
            {
              "id": "0",
              "text": "The same rate"
            },
            {
              "id": "1",
              "text": "Different rates"
            }
