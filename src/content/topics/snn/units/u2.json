          "answer": "0",
          "why": "It uses the first event latency only.",
          "options": [
            {
              "id": "0",
              "text": "The same encoded value"
            },
            {
              "id": "1",
              "text": "Different values from later counts"
            }
          ],
          "concept": "ttfs",
          "requires": [],
          "misconceptions": {}
        }
