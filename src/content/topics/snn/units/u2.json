    {
      "id": "l12",
      "number": 12,
      "title": "Earlier can mean stronger",
      "type": "lesson",
      "concepts": [
        "ttfs"
      ],
      "cards": [
        {
          "kind": "analogy",
          "title": "Start with the beaker",
          "body": "Start the beakers together. With a suitable encoder, a stronger pour reaches the line earlier. The first tip time carries the value."
        },
        {
          "kind": "numbers",
          "title": "Make it concrete",
          "body": "In one latency encoder, input A first spikes at 3 ms and B at 8 ms. A represents the stronger input under this encoder’s earlier-is-stronger rule."
        },
        {
          "kind": "equation",
          "title": "Now give it symbols",
          "body": "The symbols describe the example you just saw.",
          "steps": [
            "t_{\\mathrm{first}}=\\min\\{t:s(t)=1\\}"
          ]
        }
      ],
      "quiz": [
        {
          "id": "l12-q0",
          "kind": "single",
          "prompt": "Under an earlier-is-stronger encoder, 4 ms versus 9 ms indicates…",
          "answer": "0",
          "why": "The mapping assigns strength to earlier first spikes.",
          "options": [
            {
              "id": "0",
              "text": "The 4 ms input is stronger"
            },
            {
              "id": "1",
              "text": "The 9 ms input is stronger"
            }
          ],
          "concept": "ttfs",
          "requires": [],
          "misconceptions": {}
        },
        {
          "id": "l12-q1",
          "kind": "single",
